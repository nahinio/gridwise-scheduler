# Copy to .env and fill in values. Never commit .env.
# Names only - no real values belong in this file.

# --- LLM provider (primary + second hop share this key) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-5.4-nano
OPENAI_REASONING_EFFORT=none

# --- Optional second vendor (hop is skipped when the key is empty) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# --- Time budgets (seconds) ---
LLM_TIMEOUT_S=6
LLM_TOTAL_BUDGET_S=12

# --- Service ---
PORT=8000
LOG_LEVEL=INFO
LLM_MAX_CONCURRENCY=8
CACHE_MAX_ENTRIES=5000
CROSSCHECK_ENABLED=true
ENABLE_OPTIONAL_ENDPOINTS=true
